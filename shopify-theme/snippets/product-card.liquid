{%- comment -%}
  One product card. Shopify products are the source of truth: title, image,
  price and availability all come from the product itself.

  Nothing is invented. A product with no image shows the honest empty frame,
  and price only renders when Shopify actually has one.
{%- endcomment -%}
<a href="{{ card_product.url }}" class="pi-card pi-card--link{% if world == 'events' %} pi-world-events{% endif %}">
  <div class="pi-media pi-media--3-2 pi-media--radius-card{% unless card_product.featured_image %} pi-media--empty{% endunless %}">
    {%- if card_product.featured_image -%}
      <img src="{{ card_product.featured_image | image_url: width: 900 }}"
           alt="{{ card_product.featured_image.alt | escape }}" class="pi-media__img" loading="lazy">
    {%- else -%}
      <span class="pi-media__note">Photography pending</span>
    {%- endif -%}
  </div>

  <div class="pi-card__body">
    {%- if card_product.type != blank -%}
      <p class="pi-card__meta">
        {%- if world == 'events' -%}
          <span class="pi-event-category">{{ card_product.type }}</span>
        {%- else -%}
          {{ card_product.type }}
        {%- endif -%}
      </p>
    {%- endif -%}

    <h3 class="pi-card__title">{{ card_product.title }}</h3>

    {%- if card_product.description != blank -%}
      <p class="pi-card__summary">{{ card_product.description | strip_html | truncatewords: 22 }}</p>
    {%- endif -%}

    <div class="pi-card__foot">
      {%- if card_product.price and card_product.price > 0 -%}
        <span class="pi-price">
          <span class="pi-price__amount">{{ card_product.price | money_without_currency }}</span>
          <span class="pi-price__currency">{{ cart.currency.iso_code }}</span>
        </span>
      {%- else -%}
        <span class="pi-price"><span class="pi-placeholder">Price not set</span></span>
      {%- endif -%}

      {%- if card_product.available -%}
        <span class="pi-pill pi-pill--neutral">Available</span>
      {%- else -%}
        <span class="pi-pill pi-pill--quiet">Sold out</span>
      {%- endif -%}
    </div>
  </div>
</a>

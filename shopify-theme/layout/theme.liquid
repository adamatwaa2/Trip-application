<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="ltr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light only">
    <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {% comment %}
      PI-WB-002 typefaces. Clash Display is not licensed for the web build yet,
      so display type falls through to Plus Jakarta Sans — which is the
      fallback the brand token itself specifies. IBM Plex Sans Arabic is loaded
      ready for Arabic, which is not built yet.
    {% endcomment %}
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=IBM+Plex+Sans+Arabic:wght@400;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="{{ 'planet-infinity.css' | asset_url }}">
    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% if template.name == 'index' %} pi-home{% endif %}">
    <a class="pi-visually-hidden" href="#main">Skip to content</a>

    {% sections 'header-group' %}

    <main id="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>

<footer class="pi-night pi-footer">
  <div class="pi-container pi-container--default">
    <div class="pi-footer__top">
      <div class="pi-footer__brand">
        <a href="{{ routes.root_url }}" class="pi-brand pi-brand--ivory">
          {%- liquid
            assign footer_logo = 'planet-infinity-orange.png' | asset_url
            if section.settings.logo != blank
              assign footer_logo = section.settings.logo | image_url: height: 68
            endif
          -%}
          <img src="{{ footer_logo }}" alt="{{ shop.name }}" class="pi-logo" loading="lazy">
          <span class="pi-brand__word">{{ section.settings.wordmark | default: shop.name }}</span>
        </a>
        <p class="pi-footer__line">{{ section.settings.tagline }}</p>
      </div>

      <div class="pi-footer__cols">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            <h2 class="pi-footer__heading">{{ block.settings.title }}</h2>
            <ul class="pi-footer__list">
              {%- if block.settings.menu != blank -%}
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}" class="pi-footer__link">{{ link.title }}</a></li>
                {%- endfor -%}
              {%- elsif block.settings.use_site_nav -%}
                {%- comment -%}
                  No menu attached. Rather than an empty column, fall back to the
                  same built-in navigation the header uses — which only ever
                  links to collections and pages that already exist.
                {%- endcomment -%}
                {%- render 'nav-links', link_class: 'pi-footer__link', current_class: '', wrap_li: true -%}
              {%- endif -%}
              {%- if block.settings.show_policies -%}
                {%- comment -%}
                  Store policies come from Shopify itself. A policy that has not
                  been written yet simply does not appear — nothing is invented.
                {%- endcomment -%}
                {%- for policy in shop.policies -%}
                  <li><a href="{{ policy.url }}" class="pi-footer__link">{{ policy.title }}</a></li>
                {%- endfor -%}
              {%- endif -%}
              {%- if block.settings.soon_items != blank -%}
                {%- assign items = block.settings.soon_items | split: ',' -%}
                {%- for item in items -%}
                  <li>
                    <span class="pi-footer__link pi-footer__link--soon" aria-disabled="true">
                      {{ item | strip }}<span class="pi-nav__chip">Soon</span>
                    </span>
                  </li>
                {%- endfor -%}
              {%- endif -%}
              {%- if block.settings.free_text != blank -%}
                <li class="pi-footer__contact">{{ block.settings.free_text }}</li>
              {%- endif -%}
            </ul>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="pi-footer__bottom">
      <span>{{ section.settings.legal_line }}</span>
      <span>{{ section.settings.social_line }}</span>
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "Planet Infinity" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Travel, experiences and events. One brand, more than one world." },
    { "type": "text", "id": "legal_line", "label": "Legal line", "default": "Planet Infinity Entertainment" },
    { "type": "text", "id": "social_line", "label": "Social handle", "default": "@planetinfinity.ent" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Explore" },
        { "type": "link_list", "id": "menu", "label": "Menu" },
        { "type": "checkbox", "id": "use_site_nav", "label": "Use the site navigation when no menu is chosen", "default": false },
        { "type": "checkbox", "id": "show_policies", "label": "List the store policies written in Shopify", "default": false },
        { "type": "text", "id": "soon_items", "label": "Coming soon items (comma separated)" },
        { "type": "text", "id": "free_text", "label": "Free text line" }
      ]
    }
  ],
  "max_blocks": 6,
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}

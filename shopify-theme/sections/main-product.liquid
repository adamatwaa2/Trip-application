{%- comment -%}
  A product belongs to the Events world when it sits in the Events collection
  chosen in Theme settings → Worlds. That decides the violet accent; Infinity
  Orange still carries the primary action either way.
{%- endcomment -%}
{%- liquid
  assign world = 'travel'
  for c in product.collections
    if c.handle == settings.events_collection.handle
      assign world = 'events'
    endif
  endfor
-%}
<section class="pi-section pi-section--ivory{% if world == 'events' %} pi-world-events{% endif %}">
  <div class="pi-container pi-container--default">
    <nav class="pi-crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span></li>
        <li><span aria-current="page">{{ product.title }}</span></li>
      </ol>
    </nav>
    {%- if product.type != blank -%}<p class="pi-eyebrow">{{ product.type }}</p>{%- endif -%}
    <h1 class="pi-trip-hero__title">{{ product.title }}</h1>
  </div>
</section>

<section class="pi-section pi-section--white{% if world == 'events' %} pi-world-events{% endif %}">
  <div class="pi-container pi-container--default">
    <div class="pi-trip-layout">
      <div class="pi-trip-main">
        <div class="pi-media pi-media--21-9 pi-media--radius-hero{% unless product.featured_image %} pi-media--empty{% endunless %}">
          {%- if product.featured_image -%}
            <img src="{{ product.featured_image | image_url: width: 2000 }}"
                 alt="{{ product.featured_image.alt | escape }}" class="pi-media__img">
          {%- else -%}
            <span class="pi-media__note">Photography pending</span>
          {%- endif -%}
        </div>
        <section class="pi-trip-block" style="margin-top:var(--pi-s5)">
          <h2>Overview</h2>
          <div>{{ product.description }}</div>
        </section>
      </div>

      <div class="pi-trip-aside">
        <aside class="pi-booking">
          <div class="pi-booking__head">
            {%- if product.price and product.price > 0 -%}
              <span class="pi-price pi-price--large">
                <span class="pi-price__amount">{{ product.price | money_without_currency }}</span>
                <span class="pi-price__currency">{{ cart.currency.iso_code }}</span>
              </span>
            {%- else -%}
              <span class="pi-price pi-price--large"><span class="pi-placeholder">Price not set</span></span>
            {%- endif -%}
            {%- if product.available -%}
              <span class="pi-pill pi-pill--neutral">Available</span>
            {%- else -%}
              <span class="pi-pill pi-pill--quiet">Sold out</span>
            {%- endif -%}
          </div>

          {%- form 'product', product -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button type="submit" class="pi-btn pi-btn--primary pi-btn--large pi-booking__cta"
              {% unless product.available %}disabled{% endunless %}>
              {{ section.settings.cta_label }}
            </button>
          {%- endform -%}

          <p class="pi-booking__note">{{ section.settings.note }}</p>
        </aside>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Book now", "info": "This button adds the product to the cart and leads to Shopify checkout, so it must say so. Use \"Book now\" or \"Get tickets\" — not \"Request to book\", which promises no payment." },
    { "type": "textarea", "id": "note", "label": "Note under the CTA", "default": "You will be taken to checkout to confirm and pay." }
  ]
}
{% endschema %}

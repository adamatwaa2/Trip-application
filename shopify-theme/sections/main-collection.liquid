{%- comment -%}
  Which world this collection belongs to comes from Theme settings → Worlds,
  so the Events accent follows whatever collection is pointed at there rather
  than a handle hard-coded in the theme.
{%- endcomment -%}
{%- assign world = 'travel' -%}
{%- if collection.handle == settings.events_collection.handle -%}{%- assign world = 'events' -%}{%- endif -%}

<section class="pi-section pi-section--ivory pi-listing-hero{% if world == 'events' %} pi-world-events{% endif %}">
  <div class="pi-container pi-container--default">
    <nav class="pi-crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span></li>
        <li><span aria-current="page">{{ collection.title }}</span></li>
      </ol>
    </nav>
    <p class="pi-eyebrow">{{ collection.title }}</p>
    <h1 class="pi-listing-hero__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="pi-listing-hero__lede">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</section>

<section class="pi-section pi-section--white{% if world == 'events' %} pi-world-events{% endif %}">
  <div class="pi-container pi-container--default">
    {%- if collection.products_count > 0 -%}
      {%- paginate collection.products by 24 -%}
        <div class="pi-grid pi-grid--3">
          {%- for product in collection.products -%}
            {%- render 'product-card', card_product: product, world: world -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <div class="pi-pagination">{{ paginate | default_pagination }}</div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="pi-empty">
        <h2 class="pi-empty__title">{{ section.settings.empty_title }}</h2>
        <p class="pi-empty__body">{{ section.settings.empty_body }}</p>
        <div class="pi-empty__action">
          <a href="{{ routes.root_url }}" class="pi-btn pi-btn--secondary">Back to home</a>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "text", "id": "empty_title", "label": "Empty title", "default": "Nothing listed here yet" },
    { "type": "textarea", "id": "empty_body", "label": "Empty body", "default": "Everything is confirmed before it is listed. Add products in Shopify and they appear here automatically." }
  ]
}
{% endschema %}

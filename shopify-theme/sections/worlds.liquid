<section class="pi-night pi-section pi-section--bleed">
  <div class="pi-container pi-container--default">
    <div class="pi-heading">
      <div class="pi-heading__text">
        <p class="pi-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="pi-heading__title pi-heading__title--d2">{{ section.settings.title }}</h2>
        {%- if section.settings.lede != blank -%}<p class="pi-heading__lede">{{ section.settings.lede }}</p>{%- endif -%}
      </div>
    </div>

    <div class="pi-grid pi-grid--3">
      {%- for block in section.blocks -%}
        <article class="pi-world{% if block.settings.locked %} pi-world--locked{% endif %}" {{ block.shopify_attributes }}>
          <p class="pi-world__number">
            {{ forloop.index | prepend: '0' | slice: -2, 2 }}
            {%- if block.settings.locked %}<span class="pi-nav__chip">Soon</span>{% endif -%}
          </p>
          <h3 class="pi-world__title">{{ block.settings.title }}</h3>
          <p class="pi-world__body">{{ block.settings.body }}</p>
          {%- unless block.settings.locked -%}
            {%- if block.settings.link_label != blank -%}
              {%- assign world_href = block.settings.link_collection.url | default: block.settings.link_url | default: routes.all_products_collection_url -%}
              <a href="{{ world_href }}" class="pi-btn pi-btn--tertiary">{{ block.settings.link_label }}</a>
            {%- endif -%}
          {%- endunless -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "The worlds",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The universe" },
    { "type": "text", "id": "title", "label": "Title", "default": "More than one world" },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Each world has its own atmosphere. None of them is a side project." }
  ],
  "blocks": [
    {
      "type": "world",
      "name": "World",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Travel" },
        { "type": "textarea", "id": "body", "label": "Body" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "collection", "id": "link_collection", "label": "Collection" },
        { "type": "url", "id": "link_url", "label": "Link (used only if no collection is chosen)" },
        { "type": "checkbox", "id": "locked", "label": "Coming soon (locked)", "default": false }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "The worlds" }]
}
{% endschema %}

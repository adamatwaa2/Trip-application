{%- comment -%}
  Featured products from a Shopify collection.

  Shows real products when the collection has them and an intentional empty
  state when it does not. It never invents inventory: with an empty store this
  renders the written empty state, not fake cards.
{%- endcomment -%}
{%- assign world = section.settings.world -%}

<section class="pi-section pi-section--{{ section.settings.tone }}{% if world == 'events' %} pi-world-events{% endif %}">
  <div class="pi-container pi-container--default">
    <div class="pi-heading">
      <div class="pi-heading__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="pi-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="pi-heading__title pi-heading__title--d2">{{ section.settings.title }}</h2>
        {%- if section.settings.lede != blank -%}
          <p class="pi-heading__lede">{{ section.settings.lede }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <div class="pi-heading__action">
          <a href="{{ section.settings.link_url }}" class="pi-btn pi-btn--secondary">{{ section.settings.link_label }}</a>
        </div>
      {%- endif -%}
    </div>

    {%- assign coll = collections[section.settings.collection] -%}
    {%- if coll != blank and coll.products_count > 0 -%}
      <div class="pi-grid pi-grid--3">
        {%- for product in coll.products limit: section.settings.count -%}
          {%- assign card_product = product -%}
          {%- render 'product-card', card_product: card_product, world: world -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="pi-empty">
        <h3 class="pi-empty__title">{{ section.settings.empty_title }}</h3>
        <p class="pi-empty__body">{{ section.settings.empty_body }}</p>
        {%- if section.settings.link_label != blank -%}
          <div class="pi-empty__action">
            <a href="{{ section.settings.link_url }}" class="pi-btn pi-btn--secondary">{{ section.settings.link_label }}</a>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Products shown", "min": 2, "max": 8, "step": 1, "default": 3 },
    { "type": "select", "id": "world", "label": "World", "options": [
      { "value": "travel", "label": "Travel (orange)" },
      { "value": "events", "label": "Events (violet accent)" }
    ], "default": "travel" },
    { "type": "select", "id": "tone", "label": "Background", "options": [
      { "value": "ivory", "label": "Ivory" },
      { "value": "white", "label": "White" }
    ], "default": "ivory" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Travel" },
    { "type": "text", "id": "title", "label": "Title", "default": "Featured trips" },
    { "type": "textarea", "id": "lede", "label": "Lede" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See all" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "header", "content": "Empty state" },
    { "type": "text", "id": "empty_title", "label": "Empty title", "default": "The next departures are being confirmed" },
    { "type": "textarea", "id": "empty_body", "label": "Empty body", "default": "Nothing is listed here until it is real and bookable." }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}

# Copy this file to .env.local and fill these values from the Connect dialog
# of the NEW `planet-infinity-web` Supabase project. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key used by private receipt uploads, payment callbacks, and
# notifications. Prefer the modern sb_secret_ key. Never expose it publicly.
SUPABASE_SECRET_KEY=
# Legacy fallback for older Supabase projects only.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paymob Intention API / Unified Checkout.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_BASE_URL=https://accept.paymob.com

# Temporary/manual payment fallback. The public InstaPay address is safe to
# display to customers; the receiving account is verified manually by admin.
NEXT_PUBLIC_INSTAPAY_ADDRESS=
NEXT_PUBLIC_INSTAPAY_ACCOUNT_NAME=Planet Infinity
NEXT_PUBLIC_VODAFONE_CASH_NUMBER=
NEXT_PUBLIC_BUSINESS_WHATSAPP_NUMBER=

# WhatsApp Business Cloud API. Leave blank until Meta approves the business,
# phone number, and transactional templates.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_CONFIRMATION_TEMPLATE=
# Set to true only after approving a separate template with a PDF document header.
WHATSAPP_CONFIRMATION_TEMPLATE_HAS_DOCUMENT=false
CRON_SECRET=
